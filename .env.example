# KisanMitra Root Environment Configuration
PROJECT_NAME="KisanMitra Decision Intelligence Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite default, PostgreSQL for Docker/Production)
DATABASE_URL=sqlite:///./kisanmitra.db
# DATABASE_URL=postgresql://kisanmitra:kisanmitra123@localhost:5432/kisanmitra_db

# Security & JWT
SECRET_KEY=kisanmitra_change_this_secret_jwt_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Agro-climatic Region
DEFAULT_STATE=Uttarakhand

# Gemini LLM Configuration for Agricultural RAG
GEMINI_API_KEY=your_gemini_api_key_here
RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-3.5-flash-lite
